  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--require ./scripts/no-proc-memory.cjs' next build --webpack",
